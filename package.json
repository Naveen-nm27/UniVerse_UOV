{
  "name": "universe_uov",
  "version": "1.0.0",
  "private": true,
  "description": "UNIVERSE UOV - INTEGRATED STUDENT SERVICES SYSTEM",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:client": "npm run dev -w apps/client",
    "dev:server": "npm run dev -w apps/server",
    "seed:demo": "npm run seed:demo -w apps/server",
    "test": "npm test -w apps/server",
    "lint": "npm run lint -w apps/client",
    "build": "npm run build -w apps/client",
    "format": "prettier --write apps/client/src apps/server/src apps/server/scripts apps/server/test packages",
    "format:check": "prettier --check apps/client/src apps/server/src apps/server/scripts apps/server/test packages",
    "dev": "concurrently \"npm:dev:client\" \"npm:dev:server\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Naveen-nm27/UniVerse_UOV.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Naveen-nm27/UniVerse_UOV/issues"
  },
  "homepage": "https://github.com/Naveen-nm27/UniVerse_UOV#readme",
  "devDependencies": {
    "concurrently": "^10.0.5",
    "prettier": "^3.9.9"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true
  },
  "dependencies": {
    "ansis": "^4.4.0",
    "sql-highlight": "^6.1.0",
    "typeorm": "^0.3.31"
  }
}
